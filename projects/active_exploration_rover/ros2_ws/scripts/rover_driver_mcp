#!/usr/bin/env bash
set -eo pipefail
workspace="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
source /opt/ros/jazzy/setup.bash
source "$workspace/install/setup.bash"
export ROS_LOG_DIR="${TMPDIR:-/tmp}/rover_driver_mcp_logs"
export RCUTILS_LOGGING_USE_STDOUT=0
set -u
python="$workspace/.driver_venv/bin/python"
if [[ ! -x "$python" ]]; then
  python=python3
fi
exec "$python" -m visual_rover_agent.driver_interface
