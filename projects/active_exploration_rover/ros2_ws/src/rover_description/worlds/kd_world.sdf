<?xml version="1.0" ?>
<sdf version="1.9">
    <world name="kd_world">

        <plugin
            filename="gz-sim-physics-system"
            name="gz::sim::systems::Physics"/>

        <plugin
            filename="gz-sim-user-commands-system"
            name="gz::sim::systems::UserCommands"/>

        <plugin
            filename="gz-sim-scene-broadcaster-system"
            name="gz::sim::systems::SceneBroadcaster"/>

        <plugin
            filename="gz-sim-sensors-system"
            name="gz::sim::systems::Sensors">
            <render_engine>ogre2</render_engine>
        </plugin>

        <plugin
            filename="gz-sim-imu-system"
            name="gz::sim::systems::Imu">
        </plugin>

        <light type="directional" name="sun">
            <cast_shadows>true</cast_shadows>
            <pose>0 0 10 0 0 0</pose>
            <diffuse>0.8 0.8 0.8 1</diffuse>
            <specular>0.2 0.2 0.2 1</specular>
            <direction>-0.5 0.1 -0.9</direction>
        </light>

        <model name="ground_plane">
            <static>true</static>

            <link name="link">
                <collision name="collision">
                    <geometry>
                        <plane>
                            <normal>0 0 1</normal>
                        </plane>
                    </geometry>
                </collision>

                <visual name="visual">
                    <geometry>
                        <plane>
                            <normal>0 0 1</normal>
                            <size>100 100</size>
                        </plane>
                    </geometry>

                    <material>
                        <ambient>0.8 0.8 0.8 1</ambient>
                        <diffuse>0.8 0.8 0.8 1</diffuse>
                    </material>
                </visual>
            </link>
        </model>

        <model name="test_box">
            <static>true</static>
            <pose>2 0 0.5 0 0 0</pose>

            <link name="link">
                <collision name="collision">
                    <geometry>
                        <box>
                            <size>0.5 0.5 1.0</size>
                        </box>
                    </geometry>
                </collision>

                <visual name="visual">
                    <geometry>
                        <box>
                            <size>0.5 0.5 1.0</size>
                        </box>
                    </geometry>

                    <material>
                        <ambient>1 0 0 1</ambient>
                        <diffuse>1 0 0 1</diffuse>
                    </material>
                </visual>
            </link>
        </model>

        <model name="arena_walls">
            <static>true</static>

            <link name="west_wall">
                <pose>-1 0 0.5 0 0 0</pose>

                <collision name="collision">
                    <geometry>
                        <box>
                            <size>0.2 8.0 1.0</size>
                        </box>
                    </geometry>
                </collision>

                <visual name="visual">
                    <geometry>
                        <box>
                            <size>0.2 8.0 1.0</size>
                        </box>
                    </geometry>

                    <material>
                        <ambient>0.35 0.35 0.4 1</ambient>
                        <diffuse>0.35 0.35 0.4 1</diffuse>
                    </material>
                </visual>
            </link>

            <link name="east_wall">
                <pose>10 0 0.5 0 0 0</pose>

                <collision name="collision">
                    <geometry>
                        <box>
                            <size>0.2 8.0 1.0</size>
                        </box>
                    </geometry>
                </collision>

                <visual name="visual">
                    <geometry>
                        <box>
                            <size>0.2 8.0 1.0</size>
                        </box>
                    </geometry>

                    <material>
                        <ambient>0.35 0.35 0.4 1</ambient>
                        <diffuse>0.35 0.35 0.4 1</diffuse>
                    </material>
                </visual>
            </link>

            <link name="north_wall">
                <pose>4.5 4 0.5 0 0 0</pose>

                <collision name="collision">
                    <geometry>
                        <box>
                            <size>11.2 0.2 1.0</size>
                        </box>
                    </geometry>
                </collision>

                <visual name="visual">
                    <geometry>
                        <box>
                            <size>11.2 0.2 1.0</size>
                        </box>
                    </geometry>

                    <material>
                        <ambient>0.35 0.35 0.4 1</ambient>
                        <diffuse>0.35 0.35 0.4 1</diffuse>
                    </material>
                </visual>
            </link>

            <link name="south_wall">
                <pose>4.5 -4 0.5 0 0 0</pose>

                <collision name="collision">
                    <geometry>
                        <box>
                            <size>11.2 0.2 1.0</size>
                        </box>
                    </geometry>
                </collision>

                <visual name="visual">
                    <geometry>
                        <box>
                            <size>11.2 0.2 1.0</size>
                        </box>
                    </geometry>

                    <material>
                        <ambient>0.35 0.35 0.4 1</ambient>
                        <diffuse>0.35 0.35 0.4 1</diffuse>
                    </material>
                </visual>
            </link>

            <link name="center_divider">
                <pose>5 0 0.5 0 0 0</pose>

                <collision name="collision">
                    <geometry>
                        <box>
                            <size>3.0 0.2 1.0</size>
                        </box>
                    </geometry>
                </collision>

                <visual name="visual">
                    <geometry>
                        <box>
                            <size>3.0 0.2 1.0</size>
                        </box>
                    </geometry>

                    <material>
                        <ambient>0.25 0.3 0.45 1</ambient>
                        <diffuse>0.25 0.3 0.45 1</diffuse>
                    </material>
                </visual>
            </link>

            <link name="north_dead_end">
                <pose>6.5 2 0.5 0 0 0</pose>

                <collision name="collision">
                    <geometry>
                        <box>
                            <size>0.2 4.0 1.0</size>
                        </box>
                    </geometry>
                </collision>

                <visual name="visual">
                    <geometry>
                        <box>
                            <size>0.2 4.0 1.0</size>
                        </box>
                    </geometry>

                    <material>
                        <ambient>0.45 0.3 0.25 1</ambient>
                        <diffuse>0.45 0.3 0.25 1</diffuse>
                    </material>
                </visual>
            </link>

            <link name="far_island">
                <pose>8.2 -2 0.5 0 0 0</pose>

                <collision name="collision">
                    <geometry>
                        <box>
                            <size>0.2 2.0 1.0</size>
                        </box>
                    </geometry>
                </collision>

                <visual name="visual">
                    <geometry>
                        <box>
                            <size>0.2 2.0 1.0</size>
                        </box>
                    </geometry>

                    <material>
                        <ambient>0.25 0.45 0.3 1</ambient>
                        <diffuse>0.25 0.45 0.3 1</diffuse>
                    </material>
                </visual>
            </link>
        </model>
    </world>
</sdf>