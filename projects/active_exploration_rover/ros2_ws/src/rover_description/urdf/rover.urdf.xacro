<?xml version="1.0"?>
<robot name="kd_bot" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Define robot constants -->
  <xacro:property name="base_width" value="0.30"/>
  <xacro:property name="base_length" value="0.45"/>
  <xacro:property name="base_height" value="0.15"/>
  <xacro:property name="ground_clearance" value="0.05"/>
  <xacro:property name="base_mass" value="8.0"/>
  <xacro:property name="base_link_height" value="${ground_clearance + base_height / 2.0}"/>
  <xacro:property name="wheel_radius" value="0.075"/>
  <xacro:property name="wheel_width" value="0.04"/>
  <xacro:property name="wheel_mass" value="0.5"/>
  <xacro:property name="lidar_radius" value="0.04"/>
  <xacro:property name="lidar_height" value="0.04"/>
  <xacro:property name="lidar_mass" value="0.15"/>


  <xacro:property
  name="base_ixx"
  value="${base_mass / 12.0 * (base_width * base_width + base_height * base_height)}"/>

  <xacro:property
  name="base_iyy"
  value="${base_mass / 12.0 * (base_length * base_length + base_height * base_height)}"/>

  <xacro:property
  name="base_izz"
  value="${base_mass / 12.0 * (base_length * base_length + base_width * base_width)}"/>

  <xacro:property
  name="wheel_iyy"
  value="${wheel_mass / 2.0 * (wheel_radius * wheel_radius)}"/>

  <xacro:property
  name="wheel_ixx"
  value="${wheel_mass / 12.0 * (3.0*(wheel_radius * wheel_radius) + (wheel_width * wheel_width))}"/>

  <xacro:property
  name="wheel_izz"
  value="${wheel_mass / 12.0 * (3.0*(wheel_radius * wheel_radius) + (wheel_width * wheel_width))}"/>

  <xacro:property
    name="lidar_ixx"
    value="${lidar_mass / 12.0 * (3.0 * lidar_radius * lidar_radius + lidar_height * lidar_height)}"/>

  <xacro:property
    name="lidar_iyy"
    value="${lidar_ixx}"/>

  <xacro:property
    name="lidar_izz"
    value="${lidar_mass / 2.0 * lidar_radius * lidar_radius}"/>
  

  <!-- Robot Base -->
  <link name="base_link">
    <visual>
      <geometry>
        <box size="${base_length} ${base_width} ${base_height}"/>
      </geometry>
      <material name="Cyan">
        <color rgba="0 1.0 1.0 1.0"/>
      </material>
    </visual>
    <collision>
        <geometry>
            <box size="${base_length} ${base_width} ${base_height}"/>
        </geometry>
    </collision>
    <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <mass value="${base_mass}"/>
        <inertia
            ixx="${base_ixx}"
            ixy="0.0"
            ixz="0.0"
            iyy="${base_iyy}"
            iyz="0.0"
            izz="${base_izz}"/>
    </inertial>
  </link>
    <link name="lidar_link">
        <visual>
         <geometry>
            <cylinder radius="${lidar_radius}" length="${lidar_height}"/>
         </geometry>
        </visual>
        <collision>
            <geometry>
                <cylinder radius="${lidar_radius}" length="${lidar_height}"/>
            </geometry>
        </collision>
        <inertial>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <mass value="${lidar_mass}"/>
            <inertia
                ixx="${lidar_ixx}"
                ixy="0.0"
                ixz="0.0"
                iyy="${lidar_iyy}"
                iyz="0.0"
                izz="${lidar_izz}"/>
        </inertial>
    </link>

    <joint name="lidar_joint" type="fixed">
        <parent link="base_link"/>
        <child link="lidar_link"/>
        <origin xyz="0 0 ${base_height / 2.0 + lidar_height / 2.0}" rpy="0 0 0"/>
    </joint>

    <!-- IMU sensor link, fixed to base_link -->
    <link name="imu_link">
        <visual>
            <geometry>
                <box size="0.02 0.02 0.02"/>
            </geometry>
            <material name="Orange">
                <color rgba="1.0 0.5 0.0 1.0"/>
            </material>
        </visual>
        <collision>
            <geometry>
                <box size="0.02 0.02 0.02"/>
            </geometry>
        </collision>
        <inertial>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <mass value="0.01"/>
            <inertia
                ixx="0.000001"
                ixy="0.0"
                ixz="0.0"
                iyy="0.000001"
                iyz="0.0"
                izz="0.000001"/>
        </inertial>
    </link>

    <joint name="imu_joint" type="fixed">
        <parent link="base_link"/>
        <child link="imu_link"/>
        <origin xyz="0 0 ${base_height / 2.0 + 0.02}" rpy="0 0 0"/>
    </joint>

  
  <gazebo reference="lidar_link">
    <sensor name="lidar" type="gpu_lidar">
        <topic>/scan</topic>
        <gz_frame_id>lidar_link</gz_frame_id>
        <update_rate>10</update_rate>
        <always_on>true</always_on>
        <visualize>true</visualize>

        <ray>
            <scan>
                <horizontal>
                    <samples>1080</samples>
                    <resolution>1</resolution>
                    <min_angle>-3.14159</min_angle>
                    <max_angle>3.14159</max_angle>
                </horizontal>
            </scan>

            <range>
                <min>0.08</min>
                <max>10.0</max>
                <resolution>0.01</resolution>
            </range>
        </ray>
    </sensor>
</gazebo>

  <!-- Gazebo IMU sensor attached to imu_link; publishes /imu/data_raw -->
  <gazebo reference="imu_link">
    <sensor name="imu" type="imu">
        <topic>/imu/data_raw</topic>
        <gz_frame_id>imu_link</gz_frame_id>
        <update_rate>100</update_rate>
        <always_on>true</always_on>
        <imu>
            <angular_velocity>
                <x>
                    <noise type="gaussian">
                        <mean>0.0</mean>
                        <stddev>0.0005</stddev>
                    </noise>
                </x>
                <y>
                    <noise type="gaussian">
                        <mean>0.0</mean>
                        <stddev>0.0005</stddev>
                    </noise>
                </y>
                <z>
                    <noise type="gaussian">
                        <mean>0.0</mean>
                        <stddev>0.0008</stddev>
                    </noise>
                </z>
            </angular_velocity>
            <linear_acceleration>
                <x>
                    <noise type="gaussian">
                        <mean>0.0</mean>
                        <stddev>0.01</stddev>
                    </noise>
                </x>
                <y>
                    <noise type="gaussian">
                        <mean>0.0</mean>
                        <stddev>0.01</stddev>
                    </noise>
                </y>
                <z>
                    <noise type="gaussian">
                        <mean>0.0</mean>
                        <stddev>0.02</stddev>
                    </noise>
                </z>
            </linear_acceleration>
        </imu>
    </sensor>
</gazebo>


  <!-- Robot Footprint -->
  <link name="base_footprint"/>

  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0.0 0.0 ${base_link_height}" rpy="0 0 0"/>
  </joint>

  <xacro:macro name="wheel" params="name x y">
     <link name="${name}_wheel_link">
        <visual>
            <origin xyz="0 0 0" rpy="1.5708 0 0"/>
            <geometry>
                <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
            </geometry>
            <material name="dark gray">
                <color rgba="0.15 0.15 0.15 1.0"/>
            </material>
        </visual>

        <collision>
            <origin xyz="0 0 0" rpy="1.5708 0 0"/>
            <geometry>
                <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
            </geometry>
        </collision>
        <inertial>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <mass value="${wheel_mass}"/>
            <inertia
                ixx="${wheel_ixx}"
                ixy="0.0"
                ixz="0.0"
                iyy="${wheel_iyy}"
                iyz="0.0"
                izz="${wheel_izz}"/>
        </inertial>
     </link>

    <joint name="${name}_wheel_joint" type="continuous">
        <parent link="base_link"/>
        <child link="${name}_wheel_link"/>
        <origin xyz="${x} ${y} -0.05" rpy="0 0 0"/>
        <axis xyz="0 1 0"/>
    </joint>
  </xacro:macro>
  <xacro:wheel name="front_left" x="0.15" y="0.17"/>
  <xacro:wheel name="front_right" x="0.15" y="-0.17"/>
  <xacro:wheel name="rear_right" x="-0.15" y="-0.17"/>
  <xacro:wheel name="rear_left" x="-0.15" y="0.17"/>

    <gazebo>
    <plugin
        filename="gz-sim-diff-drive-system"
        name="gz::sim::systems::DiffDrive">

        <left_joint>front_left_wheel_joint</left_joint>
        <left_joint>rear_left_wheel_joint</left_joint>

        <right_joint>front_right_wheel_joint</right_joint>
        <right_joint>rear_right_wheel_joint</right_joint>

        <wheel_separation>0.82</wheel_separation>
        <wheel_radius>${wheel_radius}</wheel_radius>

        <topic>/cmd_vel</topic>
        <frame_id>odom</frame_id>
        <child_frame_id>base_footprint</child_frame_id>
    </plugin>
    <plugin
        filename="gz-sim-joint-state-publisher-system"
        name="gz::sim::systems::JointStatePublisher">
        <joint_name>front_left_wheel_joint</joint_name>
        <joint_name>front_right_wheel_joint</joint_name>
        <joint_name>rear_right_wheel_joint</joint_name>
        <joint_name>rear_left_wheel_joint</joint_name>
    </plugin>
    <plugin
        filename="gz-sim-odometry-publisher-system"
        name="gz::sim::systems::OdometryPublisher">

        <odom_frame>world</odom_frame>
        <robot_base_frame>base_footprint</robot_base_frame>
        <odom_publish_frequency>50</odom_publish_frequency>
        <odom_topic>/ground_truth/odometry</odom_topic>
        <tf_topic>/ground_truth/tf</tf_topic>
        <dimensions>2</dimensions>
    </plugin>
    </gazebo>

</robot>