<sdf version="1.9">
  <world name="site_cell">
    <physics name="cpu" type="ignored">
      <max_step_size>0.002</max_step_size>
      <real_time_factor>1</real_time_factor>
    </physics>
    <gravity>0 0 -9.81</gravity>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics" />
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-contact-system" name="gz::sim::systems::Contact" />
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster" />
    <model name="floor">
      <static>true</static>
      <pose>0 0 -0.05 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>8 8 0.1</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>8 8 0.1</size>
            </box>
          </geometry>
        </visual>
      </link>
    </model>
    <model name="rover">
      <pose>-2 -2 0 0 0 0</pose>
      <link name="body">
        <pose>0 0 .16 0 0 0</pose>
        <inertial>
          <mass>2</mass>
          <inertia>
            <ixx>0.03</ixx>
            <iyy>0.03</iyy>
            <izz>0.03</izz>
          </inertia>
        </inertial>
        <collision name="body_collision">
          <geometry>
            <box>
              <size>.35 .28 .12</size>
            </box>
          </geometry>
        </collision>
        <visual name="body_visual">
          <geometry>
            <box>
              <size>.35 .28 .12</size>
            </box>
          </geometry>
        </visual>
        <sensor name="scan" type="gpu_lidar">
          <pose>0 0 .2 0 0 0</pose>
          <topic>/site/scan</topic>
          <update_rate>10</update_rate>
          <always_on>true</always_on>
          <lidar>
            <scan>
              <horizontal>
                <samples>181</samples>
                <resolution>1</resolution>
                <min_angle>-3.141592653589793</min_angle>
                <max_angle>3.141592653589793</max_angle>
              </horizontal>
            </scan>
            <range>
              <min>0.05</min>
              <max>8</max>
              <resolution>0.01</resolution>
            </range>
          </lidar>
        </sensor>
        <sensor name="body_contact" type="contact">
          <always_on>true</always_on>
          <update_rate>20</update_rate>
          <contact>
            <collision>body_collision</collision>
            <topic>/site/contacts</topic>
          </contact>
        </sensor>
      </link>
      <link name="left">
        <pose>0 0.19 .1 -1.5707963267948966 0 0</pose>
        <inertial>
          <mass>0.2</mass>
          <inertia>
            <ixx>0.001</ixx>
            <iyy>0.001</iyy>
            <izz>0.001</izz>
          </inertia>
        </inertial>
        <collision name="collision">
          <geometry>
            <cylinder>
              <radius>0.1</radius>
              <length>0.035</length>
            </cylinder>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <cylinder>
              <radius>0.1</radius>
              <length>0.035</length>
            </cylinder>
          </geometry>
        </visual>
        <sensor name="wheel_contact" type="contact">
          <always_on>1</always_on>
          <update_rate>20</update_rate>
          <contact>
            <collision>collision</collision>
            <topic>/judge/wheel_contacts</topic>
          </contact>
        </sensor>
      </link>
      <joint name="left_joint" type="revolute">
        <parent>body</parent>
        <child>left</child>
        <axis>
          <xyz expressed_in="__model__">0 1 0</xyz>
        </axis>
      </joint>
      <link name="right">
        <pose>0 -0.19 .1 -1.5707963267948966 0 0</pose>
        <inertial>
          <mass>0.2</mass>
          <inertia>
            <ixx>0.001</ixx>
            <iyy>0.001</iyy>
            <izz>0.001</izz>
          </inertia>
        </inertial>
        <collision name="collision">
          <geometry>
            <cylinder>
              <radius>0.1</radius>
              <length>0.035</length>
            </cylinder>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <cylinder>
              <radius>0.1</radius>
              <length>0.035</length>
            </cylinder>
          </geometry>
        </visual>
      </link>
      <joint name="right_joint" type="revolute">
        <parent>body</parent>
        <child>right</child>
        <axis>
          <xyz expressed_in="__model__">0 1 0</xyz>
        </axis>
      </joint>
      <link name="front">
        <pose>0.14 0 .05 0 0 0</pose>
        <inertial>
          <mass>0.05</mass>
          <inertia>
            <ixx>0.0001</ixx>
            <iyy>0.0001</iyy>
            <izz>0.0001</izz>
          </inertia>
        </inertial>
        <collision name="collision">
          <geometry>
            <sphere>
              <radius>0.05</radius>
            </sphere>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>0</mu>
                <mu2>0</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <sphere>
              <radius>0.05</radius>
            </sphere>
          </geometry>
        </visual>
      </link>
      <joint name="front_joint" type="fixed">
        <parent>body</parent>
        <child>front</child>
      </joint>
      <link name="back">
        <pose>-0.14 0 .05 0 0 0</pose>
        <inertial>
          <mass>0.05</mass>
          <inertia>
            <ixx>0.0001</ixx>
            <iyy>0.0001</iyy>
            <izz>0.0001</izz>
          </inertia>
        </inertial>
        <collision name="collision">
          <geometry>
            <sphere>
              <radius>0.05</radius>
            </sphere>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>0</mu>
                <mu2>0</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <sphere>
              <radius>0.05</radius>
            </sphere>
          </geometry>
        </visual>
      </link>
      <joint name="back_joint" type="fixed">
        <parent>body</parent>
        <child>back</child>
      </joint>
      <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
        <left_joint>left_joint</left_joint>
        <right_joint>right_joint</right_joint>
        <wheel_separation>0.38</wheel_separation>
        <wheel_radius>0.1</wheel_radius>
        <topic>/site/cmd_vel</topic>
        <odom_topic>/site/odom</odom_topic>
        <odom_publish_frequency>30</odom_publish_frequency>
      </plugin>
      <plugin filename="gz-sim-odometry-publisher-system" name="gz::sim::systems::OdometryPublisher">
        <odom_topic>/judge/truth</odom_topic>
        <odom_publish_frequency>30</odom_publish_frequency>
        <dimensions>2</dimensions>
      </plugin>
    </model>
